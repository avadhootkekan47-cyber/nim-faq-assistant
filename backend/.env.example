# ─── NVIDIA NIM ───────────────────────────────────────────────────────────────
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_API_KEY=<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>
NIM_MODEL=meta/llama-3.1-8b-instruct

# ─── LLM generation settings ──────────────────────────────────────────────────
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=512
LLM_TOP_P=0.95
LLM_TIMEOUT=30          # seconds before request times out
LLM_MAX_RETRIES=3       # retries on 429 / 5xx

# ─── App ──────────────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development     # development | production

# ─── CORS (comma-separated origins) ───────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,null

# ─── FAQ ──────────────────────────────────────────────────────────────────────
FAQ_FILE=faq_data/faq.yml
FAQ_TOP_K=3             # how many FAQ matches to return before re-ranking
